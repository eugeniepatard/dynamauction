# Python and tooling
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Outputs of the scripts (TensorBoard logs, Hydra runs, figures of the results notebook)
benchmark/logs/
benchmark/outputs/
benchmark/plots/

# Results: only the data read by the results notebooks is tracked
benchmark/benchmark_results/*
!benchmark/benchmark_results/main/
!benchmark/benchmark_results/additional/

# Models tracked: (PPO, SAC, TD3 at eta = 50, seeds 42-44; MLP valuation head)
benchmark/models/**
!benchmark/models/**/
!benchmark/models/*/eta50/lr=*_seed4[234]/*
!benchmark/models/mlp_valuation_head/survival-second-price-exponential_h32-32_actrelu_ep1000_e500_lr0.001_s10000.*
